<main class="social">
  <h1>Socials</h1>
  
  <div class="social-wrapper text-center m-5">
    <div class="social-item">
      <div>
        <%= link_to image_tag("social/etsy-logo.svg", class: "social-logo", alt: "Filthy chai Etsy store link"), 
                              "https://www.etsy.com/dk-en/shop/FilthyChaii?etsrc=sdt" %>
        <span>Etsy</span>
      </div>
      <a href="https://www.etsy.com/dk-en/shop/FilthyChaii?etsrc=sdt" 
               class="social-text-link fs-3">Filthy Chai</a>
    </div>
    <div class="social-item">
      <div>
        <%= link_to image_tag("social/youtube-logo.svg", class: "social-logo", alt: "Chai cuterie Youtube page link"), 
                              "https://www.youtube.com/@chaicuterie" %>
        <span>Youtube</span>
      </div>
      <a href="https://www.youtube.com/@chaicuterie" 
              class="social-text-link fs-3">@Chaicuterie</a>
    </div>
    <div class="social-item">
      <div>
        <%= link_to image_tag("social/instagram-logo.svg", class: "social-logo", alt: "Milknthingzz instagram link"),
                              "https://www.instagram.com/milknthingzz?igsh=c3M1NXRwbnV2N3J3&utm_source=qr" %>
        <span>Instagram</span>
      </div>
      <a href="https://www.instagram.com/milknthingzz?igsh=c3M1NXRwbnV2N3J3&utm_source=qr" 
              class="social-text-link fs-3">Milknthingzz</a>
    </div>
  </div>
  
  <div class="social-about-us-link">
    <%= render "home/about" %>
  </div>
</main>
