<header class='banner-container'>
  <div class='mobile mobile-menu-container'>
    <%= image_tag('mobile-menu.png', alt: 'Menu icon', 
		id: 'mobile-menu-button', 
		class: 'mobile mobile-menu-button', 
    data: {
    controller: "menu",
    action: "click->menu#openMenu"
    }) %>
  </div>
    <div id='banner'>
      <%= link_to root_path do %>
        <span class="banner-title">Milk 'N' <br class="mobile-break"> Thingzz</span>
      <% end %>
    </div>

    <%# Logic to handle how/when to display cart and/or profile button or a sign in %>
    <%# Will also need some styling to make look better too - this is a reminder %>

    <div class="profile-button-container">
      <div class="btn-group profile-button shopping-cart-icon-container">
        <%= link_to cart_path do %>
          <span id="cart-svg-count">
            <%= cart_item_count %>
          </span>
          <%= image_tag "svg/cart.svg", class: "me-5" %>
        <% end %>
      </div>
      <% if user_signed_in? %>
        <div class='btn-group profile-button'>
          <a class='btn' type='button' id='dropdownMenuButton1' data-bs-toggle='dropdown' aria-expanded='false'>
            <%= image_tag('svg/profile.svg', alt: 'Profile Icon', class:'profile-svg' ) %>
          </a>
          <ul class='dropdown-menu dropdown-menu-dark'>
            <li><%= link_to 'My Profile', profile_path, type: 'button', class:'dropdown-item' %></li>
            <li><hr class='dropdown-divider'></li>
            <li><%= link_to 'Sign Out', destroy_user_session_path, data: { turbo_method: :delete },  class:'dropdown-item' %></li>
            <% if current_user&.admin? %>
              <li><hr class='dropdown-divider'></li>
              <%= link_to 'Admin Dashboard', admin_index_path, class:'dropdown-item' %>
            <% end %>
          </ul>
        </div>
      <% else %>
        <div class='btn-group profile-button'>
          <a class='btn' type='button' id='dropdownMenuButton1' data-bs-toggle='dropdown' aria-expanded='false'>
            <%= image_tag('svg/profile.svg', alt: 'Profile icon', class:'profile-svg' ) %>
          </a>
          <ul class='dropdown-menu dropdown-menu-dark'>
            <li><%= link_to 'Sign In', new_user_session_path, class:'dropdown-item' %></li>
            <li><hr class='dropdown-divider'></li>
            <li><%= link_to 'Sign Up', new_user_registration_path, class:'dropdown-item' %></li>
          </ul>
        </div>
      <% end %>
    </div>
</header>
