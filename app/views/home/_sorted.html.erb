<div class='grid-sorted mt-5'>
  <% @crafts.each do |craft| %>
    <% if craft.images.present? %>
      <div class='sorted-image-container'>
        <%= link_to craft_path(craft.slug) do %>
          <%= image_tag(craft.images.first.image_url(:card) || craft.images.first.image_url, class: 'sorted-img') %>
        <% end %>
      </div>
    <% else %>
    <% end %>
  <% end %>
</div>

<% if @crafts.empty? %>
  <div class="center fs-3 m-5">
    <p>There aren't any crafts of this type yet! :(</p>
    <p>Check back later when some are added! :)</p>
  </div>
  <%= render 'home/about' %>
<% end %>
