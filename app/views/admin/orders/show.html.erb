<main class="order-show admin-order-show">
  <h1>Admin::Orders#show</h1>
  
  <div class="order-container light-accent-color">
    <div class="order-header row">
      <div class="shipping-info col">
        <div class="row">
          <p class="col">Carrier:</p>
          <p class="col"><%= @order.shipping_carrier %></p>
        </div>
        <div class="row">
          <p class="col">Tracking Number:</p>
          <p class="col"><%= @order.tracking_number %></p>
        </div>
        <div class="row">
          <p class="col">State:</p>
          <p class="col"><%= @order.shipping_state %></p>
        </div>
        <div class="row">
          <p class="col">City:</p>
          <p class="col"><%= @order.shipping_city %></p>
        </div>
        <div class="row">
          <p class="col">Zip:</p>
          <p class="col"><%= @order.shipping_postal_code %></p>
        </div>
        <div class="row">
          <p class="col">Address:</p>
          <p class="col"><%= @order.shipping_address_line1 %></p>
        </div>
        <% if @order.shipping_address_line2 %>
          <div class="row">
            <p class="col">Address Line_2:</p>
            <p class="col"><%= @order.shipping_address_line2 %></p>
          </div>
        <% end %>
        <div class="row">
          <p class="col">Name:</p>
          <p class="col"><%= @order.shipping_name %></p>
        </div>
      </div>

      <div class="col"></div>

      <div class="order-info col">
        <div class="row">
          <p class="col">Order Number:</p>
          <p class="col"><%= @order.id %></p>
        </div>
        <% unless @order.guest? %>
          <div class="row">
            <p class="col">User:</p>
            <p class="col"><strong><%= @user.email %></strong> (ID: <%= @user.id %>)</p>
          </div>
        <% else %>
          <div class="row">
            <p class="col">User:</p>
            <p class="col"><strong>Guest (<%= @order.email %>)</strong></p>
          </div>
        <% end %>
        <div class="row">
          <p class="col">Stripe Payment Number:</p>
          <p class="col"><%= @order.stripe_payment_intent_id %></p>
        </div>
        <div class="order-totals col">
          <div class="row">
            <p class="col">Subtotal:</p>
            <p class="col"><%= number_to_currency(@order.subtotal) %></p>
          </div>

          <% if @order.tax_total %>
            <div class="row">
              <p class="col">Taxes:</p>
              <p class="col"><%= number_to_currency(@order.tax_total/100) %></p>
            </div>
          <% else %>
            <div class="row">
              <p class="col">Taxes:</p>
              <p class="col">?</p>
            </div>
          <% end %>

          <% if @order.shipping_total %>
            <div class="row">
              <p class="col">Shipping: </p>
              <p class="col"><%= number_to_currency(@order.shipping_total/100) %></p>
            </div>
          <% else %>
            <div class="row">
              <p class="col">Shipping:</p>
              <p class="col">?</p>
            </div>
          <% end %>

          <% if @order.total %>
            <div class="row">
              <p class="col">Total:</p>
              <p class="col"><span class="green"><%= number_to_currency(@order.total/100) %></span></p>
            </div>
          <% else %>
            <div class="row">
              <p class="col">Total:</p>
              <p class="col">?</p>
            </div>
          <% end %>
        </div>
      </div>



    </div>

    <div class="order-items">
      <% @order.order_items.each do |item| %>
        <%= render "orders/order_item", order_item: item %>
      <% end %>
    </div>
  </div>

  <%= render "shared/back" %>
</main>
