<div class="order_item">
  <div class="name">
    <% if order_item.variant_name === "default" %>
      <%= order_item.craft_name %>
    <% else %>
      <%= order_item.craft_name %> :
      <%= order_item.variant_name %>
    <% end %>
  </div>

  <% if order_item.sku %>
    <div class="sku">
      <%= order_item.sku %>
    </div>
  <% end %>

  <div class="price">
    <%= order_item.quantity %> @ 
    <%= number_to_currency(order_item.price) %>
  </div>
</div>