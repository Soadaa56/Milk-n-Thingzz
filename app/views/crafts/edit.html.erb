<h1 class>Edit Craft</h1>
<div class='center mb-3'>
  <%= link_to 'All Crafts', crafts_path, class:'btn btn-dark' %>
  <%= link_to 'View This Post', craft_path(@craft), class: 'btn btn-primary' %>
</div>

<div class='center'>
  <% if @craft.images.present? %>
    <%= image_tag @craft.images.first.image_url(:detail), class: 'max-size-image' %>
  <% end %>
</div>

<% if @craft.subtype.present? %>
  <h4 class="center">Subtype: <%= @craft.subtype %></h4>
<% end %>
<%= render 'form', craft: @craft %>
<br><br><br>

<div class="ms-5 mb-5">
  <p class="large-text ms-1">This button is to remove this post all together!</p>
  <%= button_to 'Destroy Craft', craft_path(@craft), method: :delete, data: { turbo: false}, 
      onclick: "return confirm('Are you sure you want to delete this craft?');", 
      class: 'btn btn-danger ms-1' %>
</div>


<%= link_to 'Back', :back, class:'mt-5 btn btn-custom indent', style: 'margin-left: 5rem' %>
