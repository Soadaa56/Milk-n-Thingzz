<h1 class>Edit Craft</h1>
<div class="center d-grid gap-3 m-3">
  <div>
    <%= link_to "All Crafts", crafts_path, class:'btn btn-dark fs-5' %>
    <%= link_to "View This Post", craft_path(@craft.slug), class: 'btn btn-dark fs-5' %>
  </div>
  <div>
    <% if @craft.variants %>
      <%= link_to "View All Variants", craft_variants_path(@craft), class: 'btn btn-primary fs-4' %>
    <% end %>
    <%= link_to "Add Variant", new_craft_variant_path(@craft), class: 'btn btn-primary fs-4' %>
  </div>
</div>

<div class="center">
  <% if @craft.images.present? %>
    <%= image_tag @craft.images.first.image_url(:card), class: 'max-size-image' %>
  <% end %>
</div>

<% if @craft.subtype.present? %>
  <h4 class="center">Subtype: <%= @craft.subtype %></h4>
<% end %>
<%= render 'form', craft: @craft %>
<br><br><br>

<div class="ms-5 mb-5">
  <p class="large-text ms-1">This button is to remove this post all together!</p>
  <%= button_to 'Destroy Craft', craft_path(@craft), 
      method: :delete, 
      data: { turbo: false }, 
      onclick: "return confirm('Are you sure you want to delete this craft?');", 
      class: "btn btn-danger ms-1" %>
</div>

<%= render 'shared/back' %>