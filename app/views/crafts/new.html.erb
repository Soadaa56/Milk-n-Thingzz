<h1>New Craft</h1>

<div class='center'>
  <%= link_to 'Admin Dashboard', admin_index_path, class:'btn btn-dark' %>
  <%= link_to 'List all crafts', crafts_path, class: 'btn btn-primary' %>
</div>

<div class="indent large-text edit-craft-form">
  <%= form_with model: @craft, html: { enctype: "multipart/form-data" } do |f| %>
    <% if @craft.errors.any? %>
      <div style="color: red">
        <h2><%= pluralize(@craft.errors.count, "error") %> prohibited this craft from being saved:</h2>

        <ul>
          <% @craft.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="row align-items-start">
      <div class="col">
        <div>
          <%= f.label :name, style: "display: block" %>
          <%= f.text_field :name %>
        </div>
        <div data-controller="subtype">
          <div data-action="change->subtype#updateSubtype">
            <%= f.label :category, style: "display: block" %>
            <%= f.select :category, ["3D-Print", "Crotchet", "Embroidery", "Earring", "Painting", "Necklace", "Miscellaneous"] %>
          </div>
          <div data-subtype-target="subtype">
            <%=  f.label :subtype, style: "display: block" %>
            <%=  f.select :subtype, [] %>
          </div>
        </div>
      </div>
      <div class="col">
        <div>
          <%= f.label :description, style: "display: block" %>
          <%= f.text_area :description, rows: 5, cols: 40 %>
        </div>
        <div>
          <%= f.label :dimensions, style: "display: block" %>
          <%= text_field_tag :dimensions %>
        </div>
      </div>
    </div>
  
    <h3 style="font-size: 3rem;">Back-end Info</h3>
    <div class="mt-2 mb-4 row align-items-start">
      <div class="col">
        <div>
          <%= f.label :for_sale %>
          <%= f.check_box :for_sale %>
        </div>
        <div>
          <%= f.label :price %>
          <%= number_field_tag :price %>
        </div>
        <div>
          <%= f.label :inventory_count %>
          <%= number_field_tag :inventory_count %>
        </div>
      </div>
    </div>
    <br><br>
  
    <h3 style="font-size: 3rem;">Images</h3>
    <div class="mt-2 mb-4">
      <label for='files'>Upload New Images:</label>
      <%= file_field_tag 'files[]', multiple: true %>
      <p>To delete images, check the box next to the image then update craft.</p>
    </div>
    <br><br>
  
    <div>
      <%= f.submit "Create New Craft", class: "btn btn-primary" %>
    </div>
</div>

<% end %>

<%= link_to 'Back', :back, class:'btn btn-custom indent', style: 'margin-left: 5rem' %>