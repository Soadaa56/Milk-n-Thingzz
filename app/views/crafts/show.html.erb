<main>
  <article>
    <header class="mb-3">
      <h1><%= @craft.name %></h1>
      <%# Desktop only, link to category page %>
      <h2 class="craft-show-category desktop">
        <%= link_to @craft.category,
              craft_category_path_helper(@craft),
              class:"center nav-link" %>
      </h2>
      <%# Mobile only, link to store w/ filter applied %>
      <h2 class="craft-show-category mobile">
        <%= link_to @craft.category,
              home_store_path(category: @craft.category),
              class:"center nav-link" %>
      </h2>
      
      <% if @craft.subtype.present? %>
        <div class="center"><%= @craft.subtype %></div>
      <% end %>
    </header>
    

    
    <% if @craft.has_variants? %>
      <div class="center mb-3">
        <%= render "craft_multiple_variants", craft_variants: @craft.variants %>
      </div>
    <% else %>
      <div class="center mb-3">
        <%= render "craft_single_variant", cv: @craft.variants.first %>
      </div>
    <% end %>

    <% if @craft.description.present? %>
      <div class="craft-info">
        <h2 class="underline">About This Craft</h2>
        <div class="description"><%= @craft.description %></div>
      </div>
    <% end %>

    <% if @craft.details.present? && false %>
      <div class="craft-details"
           data-controller="craft-details">
        <span>Craft Details</span>
        <div class="chevron-container center"
             data-craft-details-target="chevron">
          <%= image_tag("svg/right-thin-chevron.svg",
                        class: "chevron center",
                        data: {
                          action: "click->craft-details#toggleDetails"
                        })%>
        </div>
        <div hidden
             data-craft-details-target="details">
          <%= @craft.details %>
        </div>
      </div>
    <% end %>
    
    <%= render "shared/back" %>
  </article>
</main>