<%# :for sale | :in_stock | :active  %>
<h1 class="debug m-2 p-2">Single Craft Debug</h1>

<div class="row">
  <div class="col">
      <%#= render "gallery", craft: @craft %>
      <%= render "carousel", craft: @craft %>
  </div>

  <div class="col">
    <section class="fs-2">
      <h3 class="fs-0 underline">Craft Information</h3>
        <% if cv.craft.description && cv.craft.description != "" %>
          <div class="d-flex flex-row p-2">
            <p class="p-2">Description: </p>
            <p class="p-2"><%= cv.craft.description %></p>
          </div>
        <% end %>
        
        <% if cv.effective_dimensions && cv.effective_dimensions != "" %>
          <div class="d-flex flex-row p-2">
            <p class="p-2">Dimensions: </p>
            <p class="p-2"><%= cv.effective_dimensions %></p>
          </div>
        <% end %>
    </section>

    <section class="debug">
      <% if cv.craft.for_sale? && cv.in_stock? %>
        <div>
          <div><%= number_to_currency(cv.effective_price) %></div>
          <span><%= button_to "Add To Cart", type: "button" %></span>
          <%# Will need to connect to a cart model/object %>
          <%= select_tag :quantity, options_for_select(1..cv.stock)  %>
        </div>

      <% elsif cv.craft.for_sale? && cv.stock = 0 %>
        <div>
          <p>
            Sorry! I'm out of stock for the current item. Hopefully it will come back in stock soon
            but feel free to email me for inquiries.
          <span><%= button_to "Email Me", type: "button" %></span>
          </p>
          <div><%= number_to_currency(cv.effective_price) %></div>
        </div>
      <% else %>
        <div>
          <p>
            Sorry! This craft isn't being sold right now, but if you're interested I would love to
            make you a custom order.
            <span><%= button_to "Email Me", type: "button" %></span>
          </p>
        </div>
      <% end %>
    </section>
  </div>
</div>