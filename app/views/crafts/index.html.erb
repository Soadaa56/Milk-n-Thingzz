<h1>All Crafts</h1>
<div class='center fs-3 mb-5'>
  <% if current_user.admin? %>
    <%= link_to 'Admin Dashboard', admin_index_path, class:'btn btn-dark fs-5' %>
    <%= link_to 'Create craft posting', new_craft_path, class:'btn btn-primary fs-4' %>
  <% end %>
</div>

<table class="table table-dark table-hover m-2">
  <thead class="craft-table-head">
    <tr class="center fs-4">
      <th scope="col">ID</th>
      <th scope="col">Name</th>
      <th scope="col">Price</th>
      <th scope="col">Stock</th>
      <th scope="col">Image</th>
      <th scope="col">Edit</th>
      <th scope="col">Variants?</th>
      <th scope="col">Delete</th>
    </tr>
  </thead>
  <tbody class="center craft-table-body">
    <% @crafts.each do |craft| %>
      <tr class="fs-5">
        <th scope="row" class="align-middle"><%= craft.id %></th>
        <td class="align-middle">
          <%= link_to craft.name, craft_path(craft.slug) %>
        </td>
        <td class="align-middle">
          <%= craft.variants.first.effective_price || "X" %>
        </td>
        <td class="align-middle">
          <%= craft.variants.first.stock || "X" %>
        </td>
        <td class="align-middle">
          <% if craft.images.any? && craft.images.first.image_url(:small) %>
            <%= image_tag craft.images.first.image_url(:small), 
                class: "thumbnail-image" %>
          <% end %>
        </td>
        <td class="align-middle">
          <%= link_to 'Edit Craft', edit_craft_path(craft) %>
        </td>
        <td class="align-middle">
          <% if craft.has_variants? %>
            <span>
              <%= link_to "Yes - #{craft.variants.size - 1}", 
                  craft_variants_path(craft),
                  class: "fs-4",
                  style: "text-decoration: none" %>
            </span>
          <% else %>
            <span>X</span>
          <% end %>
        </td>
        <td class="align-middle">
          <%= button_to 'Destroy Craft', craft_path(craft), 
              method: :delete, 
              data: { turbo: false}, 
              onclick: "return confirm('Are you sure you want to delete this craft?');", 
              class: 'btn btn-danger ms-1' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= render 'shared/back' %>

<% console %>

