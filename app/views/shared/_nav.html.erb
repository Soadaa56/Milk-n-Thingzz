<nav>
  <%= image_tag("close.svg", 
        alt: "Close icon",
        class: "close-svg",
        data: {
        controller: "nav",
        action: "click->nav#closeNav"
        }) 
  %>
  <ul>
    <li><%= link_to "Crochet", home_crochet_path, class:"nav-item" %></li>
    <li><%= link_to "Earrings", home_earring_path, class:"nav-item" %></li>
    <li><%= link_to "Embroidery", home_embroidery_path, class:"nav-item" %></li>
    <li><%= link_to "Necklaces", home_necklace_path, class: "nav-item" %></li>
    <li><%= link_to "3-D Prints", home_print_path, class:"nav-item" %></li>
    <%# Perhaps conditional for misc path if misc crafts active %>
    <%# and/or show number of crafts in each ctaegory? %>
    <li><%= link_to "Misc.", home_miscellaneous_path, class:"nav-item" %></li>

    <li class="social-links">
      <%= link_to image_tag('social/etsy-logo.svg', class: 'social-link-img'), 
                            'https://milknthingz.etsy.com/',
                            target: :_blank %>
      <%= link_to image_tag('social/youtube-logo.svg', class: 'social-link-img'), 
                            'https://www.youtube.com/@chaicuterie',
                            target: :_blank %>
      <%= link_to image_tag('social/instagram-logo.svg', class: 'social-link-img'), 
                            'https://www.instagram.com/milknthingzz?igsh=c3M1NXRwbnV2N3J3&utm_source=qr',
                            target: :_blank %>
    </li>
  </ul>

  <%# Not loading currently, but implementing later. %>
  <%# Goal to move profile out of header since not critical to the app; doesnt need to be as prominent %>
  <% if user_signed_in? %>
  <div class='btn-group profile-button'>
    <a class='btn' type='button' id='dropdownMenuButton1' data-bs-toggle='dropdown' aria-expanded='false'>
      <%= image_tag('svg/profile.svg', alt: 'Profile Icon', class:'profile-svg' ) %>
    </a>
    <ul class='dropdown-menu dropdown-menu-dark'>
      <li><%= link_to 'My Profile', profile_path, type: 'button', class:'dropdown-item' %></li>
      <li><hr class='dropdown-divider'></li>
      <li><%= link_to 'Sign Out', destroy_user_session_path, data: { turbo_method: :delete },  class:'dropdown-item' %></li>
      <% if current_user&.admin? %>
        <li><hr class='dropdown-divider'></li>
        <%= link_to 'Admin Dashboard', admin_index_path, class:'dropdown-item' %>
      <% end %>
    </ul>
  </div>
<% else %>
  <div class='btn-group profile-button'>
    <a class='btn' type='button' id='dropdownMenuButton1' data-bs-toggle='dropdown' aria-expanded='false'>
      <%= image_tag('svg/profile.svg', alt: 'Profile icon', class:'profile-svg' ) %>
    </a>
    <ul class='dropdown-menu dropdown-menu-dark'>
      <li><%= link_to 'Sign In', new_user_session_path, class:'dropdown-item' %></li>
      <li><hr class='dropdown-divider'></li>
      <li><%= link_to 'Sign Up', new_user_registration_path, class:'dropdown-item' %></li>
    </ul>
  </div>
<% end %>
</nav>