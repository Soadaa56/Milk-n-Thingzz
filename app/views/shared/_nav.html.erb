<nav data-controller="nav">
  <%= image_tag("close.svg", 
        alt: "Close icon",
        class: "close-svg",
        data: {
        action: "click->nav#closeNav"
        }) 
  %>

  <ul>
    <li><%= link_to "Crochet", home_store_path(category: "Crochet"), class:"nav-item",
              data: { turbo_frame: "crafts-list",
                      action: "click->nav#closeNav" } %></li>
    <li><%= link_to "Earrings", home_store_path(category: "Earring"), class:"nav-item",
              data: { turbo_frame: "crafts-list",
                      action: "click->nav#closeNav" } %></li>
    <li><%= link_to "Embroidery", home_store_path(category: "Embroidery"), class:"nav-item",
              data: { turbo_frame: "crafts-list",
                      action: "click->nav#closeNav" } %></li>
    <li><%= link_to "Necklaces", home_store_path(category: "Necklace"), class: "nav-item",
              data: { turbo_frame: "crafts-list",
                      action: "click->nav#closeNav" } %></li>
    <li><%= link_to "3-D Prints", home_store_path(category: "3D-Print"), class:"nav-item",
              data: { turbo_frame: "crafts-list",
                      action: "click->nav#closeNav" } %></li>
    <%# Perhaps conditional for misc path if misc crafts active %>
    <%# and/or show number of crafts in each ctaegory? %>
    <li><%= link_to "Miscellaneous", home_store_path(category: "Miscellaneous"), class:"nav-item",
              data: { turbo_frame: "crafts-list",
                      action: "click->nav#closeNav" } %></li>

    <li class="social-links">
      <%= link_to image_tag('social/etsy-logo.svg', class: 'social-link-img'), 
                            'https://milknthingz.etsy.com/',
                            target: :_blank %>
      <%= link_to image_tag('social/youtube-logo.svg', class: 'social-link-img'), 
                            'https://www.youtube.com/@chaicuterie',
                            target: :_blank %>
      <%= link_to image_tag('social/instagram-logo.svg', class: 'social-link-img'), 
                            'https://www.instagram.com/milknthingzz?igsh=c3M1NXRwbnV2N3J3&utm_source=qr',
                            target: :_blank %>
    </li>
  </ul>
</nav>

<div class="filter-overlay"
  data-nav-filter-target="overlay"
  data-action="click->nav#close">
</div>
