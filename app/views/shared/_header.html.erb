<header class='banner-container'>
  <div class='mobile mobile-menu-container'>
    <%= image_tag('mobile-menu.png', alt: 'Menu icon', 
		id: 'mobile-menu-button', 
		class: 'mobile mobile-menu-button', 
    data: {
    controller: "nav",
    action: "click->nav#openNav"
    }) %>
  </div>
    <div id='banner'>
      <%= link_to root_path do %>
        <span class="banner-title">Milk 'N' <br class="mobile-break"> Thingzz</span>
      <% end %>
    </div>

    <div class="shopping-cart-svg-container">
      <%= link_to cart_path do %>
        <%= image_tag "svg/cart.svg", class: "shopping-cart-svg" %>
          <% if current_cart %>
            <span id="cart-svg-count" class="cart-svg-count">
              <%= cart_item_count unless cart_item_count == 0 %>
            </span>
          <% end %>
      <% end %>
    </div>

</header>
