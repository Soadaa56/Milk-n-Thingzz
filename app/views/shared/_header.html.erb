<header class='banner-container'>
  <div class='mobile mobile-menu-container'>
    <%= image_tag('mobile-menu.png', alt: 'Menu icon', 
		id: 'mobile-menu-button', 
		class: 'mobile mobile-menu-button', 
    data: {
    controller: "nav",
    action: "click->nav#openNav"
    }) %>
  </div>
    <div id='banner'>
      <%= link_to root_path do %>
        <span class="banner-title">Milk 'N' <br class="mobile-break"> Thingzz</span>
      <% end %>
    </div>

    <%# Logic to handle how/when to display cart and/or profile button or a sign in %>
    <%# Will also need some styling to make look better too - this is a reminder %>

    <div class="profile-button-container">
      <div class="btn-group profile-button shopping-cart-icon-container">
        <%= link_to cart_path do %>
          <span id="cart-svg-count">
            <% if current_cart %>
              <%= cart_item_count unless cart_item_count == 0 %>
            <% end %>
          </span>
          <%= image_tag "svg/cart.svg", class: "me-5" %>
        <% end %>
      </div>

    </div>
</header>
