<h1>Your Cart</h1>

<div class="center fs-1">
  <p>cart_id: <%= @cart.id %>  to user_id: <%= @cart.user_id %></p>
  <br>
  <p>total items in cart: <%= @cart.item_count %></p>

  <%# Need logic to handle if craft has variants  %>
  <div class="cart-container">
    <% @cart.cart_items.each do |ci| %>
      <%= link_to ci.variant.craft.name, craft_path(ci.variant.craft.slug) %>
       : 
      <%= ci.quantity %> @ <%= number_to_currency(ci.variant.effective_price)%>

      <%= button_to "Remove", cart_cart_item_path(@cart, ci),
          method: :delete,
          class: "btn btn-sm btn-danger" %>

      <% if ci.quantity > 1 %>
        <div>
          <%= number_to_currency(ci.item_subtotal) %>
        </div>
      <% end %>
    <% end %>
  </div>

  <br><br><br>
  <div>
    Cart Subtotal (Before Any Applicable Taxes or Fees)
    <div><%= number_to_currency(@cart.subtotal) %></div>
    <br>
    <%= button_to "Checkout With Shopify/Stripe", {}, disabled: true %>
  </div>
</div>

<% console %>