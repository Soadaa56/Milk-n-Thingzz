<main class="cart">
  <h1>Your Cart</h1>
  
  <div class="center">
    <div class="cart-container">
      <% @cart_items.each do |cart_item| %>
        <%= turbo_frame_tag dom_id(cart_item) do %>
          <%= render "cart_item", cart_item: cart_item %>
        <% end %>
      <% end %>
    </div>

    <div class="cart-checkout">
      <div id="cart-subtotal" class="cart-subtotal">
        <%= render "subtotal", cart: @cart %>
      </div>
      <%= button_to "Shopify Checkout",
                    {},
                    disabled: true,
                    class: "cart-checkout-button" %>
    </div>
  </div>
</main>