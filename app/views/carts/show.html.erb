<h1>Your Cart</h1>

<div class="center fs-1">
  <div id="cart-count">
    <%= render "cart_count", cart: @cart %>
  </div>

  <div class="cart-container">
    <% @cart_items.each do |cart_item| %>
      <%= turbo_frame_tag dom_id(cart_item) do %>
        <%= render "cart_item", cart_item: cart_item %>
      <% end %>
    <% end %>
  </div>

  <br><br><br>
  <div id="cart-subtotal">
    <%= render "subtotal", cart: @cart %>
  </div>
  <div>
    <%= button_to "Checkout With Shopify/Stripe", {}, disabled: true %>
  </div>
</div>