<%# Need logic to handle if craft has variants %>

<div class="cart_item">
  <%= image_tag cart_item.variant.images.first.image_url(:small) %>

  <%= link_to cart_item.variant.craft.name,
        craft_path(cart_item.variant.craft.slug),
        data: { turbo_frame: "_top" } %>
  :
  <%= cart_item.quantity %> @ <%= number_to_currency(cart_item.variant.effective_price)%>

  <%= button_to cart_cart_item_path(cart_item),
      method: :patch,
      params: { cart_item: { quantity: cart_item.quantity - 1 } },
      class: "cart-quantity-button" do %>
    <%= image_tag "svg/minus-circle.svg",
        style: "max-width: 24px;" %>
  <% end %>

  <%= button_to cart_cart_item_path(cart_item),
      method: :patch,
      params: { cart_item: { quantity: cart_item.quantity + 1 } },
      class: "cart-quantity-button" do %>
    <%= image_tag "svg/plus-circle.svg",
        style: "max-width: 24px;" %>
  <% end %>

  <%= button_to "Remove Item", 
        cart_cart_item_path(cart_item),
        method: :delete,
        class: "btn btn-sm btn-danger" %>

  <% if cart_item.quantity > 1 %>
    <div>
      <%= number_to_currency(cart_item.item_subtotal) %>
    </div>
  <% end %>
</div>