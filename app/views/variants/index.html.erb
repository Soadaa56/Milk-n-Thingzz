<h1>All Variants of: <%= @craft.name %></h1>
<div class="center">
  <%= link_to 'View Craft', craft_path(@craft), class: "btn btn-dark fs-5 mt-3 mb-3" %>
</div>

<table class="table table-dark table-hover m-2">
  <thead>
    <tr class="center fs-3">
      <th scope="col">Name</th>
      <th scope="col">SKU</th>
      <th scope="col">Inventory Count</th>
      <th scope="col">Price</th>
      <th scope="col">Image</th>
      <th scope="col">
        <%= link_to "Add Variant", new_craft_variant_path(@craft), class: "btn btn-primary fs-4" %>
      </th>
      <th scope="col">Active</th>
      <th scope="col">Shopify-var-id</th>
      <th scope="col">Delete</th>
    </tr>
  </thead>
  <tbody class="center">
    <tr class="fs-4 debug">
      <% @variants.each do |v| %>
      <th scope="row" class="align-middle fs-4"><%= v.name %></th>
      <td class="align-middle fs-4"><%= v.sku || "X" %></td>
      <td class="align-middle fs-4"><%= v.inventory_count || "X" %></td>
      <td class="align-middle fs-4"><%= v.effective_price || "X" %></td>
      <td class="align-middle fs-4">
        <% if v.images.any? && v.images.first.image_url(:small) %>
          <%= image_tag v.images.first.image_url(:small), class: "thumbnail-image" %>
        <% end %>
      </td>
      <td class="align-middle fs-4"><%= link_to 'Edit Variant',  edit_craft_variant_path(@craft, v.id) %></td>
      <td class="align-middle fs-4">
        <% if v.active? %>
          <span>Yes</span>
        <% else %>
          <span>X</span>
        <% end %>
      </td>
      <td class="align-middle fs-4"><%= v.shopify_variant_id %></td>
      <td class="align-middle fs-4">
        <%= button_to 'Delete Variant', craft_variant_path(craft_id: @craft.id, id: v.id), 
            method: :delete,
            data: { turbo: false },
            onclick: "return confirm('Are you sure you want to delete this variant?');",
            class: "btn btn-danger ms-1" %>
      </td>
    </tr>
    <% end %>
  </tbody>
</table>

<%= render 'shared/back' %>

<% console %>