<div class="indent edit-craft-form">
  <%= form_with model: [@craft, @variant], html: {enctype: "multipart/form-data"} do |f| %>
    <% if @variant.errors.any? %>
      <div style="color: red">
        <h2><%= pluralize(@variant.errors.count, "error") %> prohibited this variant from being saved:</h2>
        <ul>
          <% @variant.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="row align-items-start mt-4 mb-4 dark-accent-color">
      <div class="col d-grid gap-4">
        <div>
          <%= f.label :name, style: "display: block" %>
          <%= f.text_field :name %>
        </div>
        <div>
          <%= f.label :stock, style: "display: block" %>
          <%= f.number_field :stock, step: 1 %>
          <p class="yellow">
            <strong>Blank</strong> is <strong>valid</strong>
          </p>
          <p class="yellow">
            0 means we are currently out of stock but ideally have in stock
          </p>
        </div>
      </div>
      <div class="col d-grid gap-4">
        <div>
          <div class="d-inline-flex">
            <div>
              <%= f.label :price, style: "display: block" %>
              <%= f.number_field :price, step: 0.01 %>
            </div>
            <div class="yellow ms-2 mt-4"><strong>Overides</strong> defaults price</div>
          </div>
          <p class="green mt-1">
            <% if @craft.default_price %>
              <strong>Default(base)</strong> craft price = <strong><%= number_to_currency(@craft.default_price) %></strong>
            <% else %>
              There is no base craft price.
            <% end %>
          </p>
        </div>
        <div class="d-inline-flex">
          <div>
            <%= f.label :dimensions, style: "display: block" %>
            <%= f.text_area :dimensions, rows: 2, cols: 24 %>
          </div>
          <p class="yellow ms-2 mt-4"><strong>Overrides</strong> defaults dimensions</p>
        </div>
      </div>
    </div>

    <div class="row align-items-start mt-5 mb-5">
    <h3 style="font-size: 3rem;">Back-end Info</h3>
      <div class="col d-grid gap-4 dark-accent-color">
        <div>
          <%= f.label :sku, style: "display: block" %>
          <%= f.text_field :sku %>
          <p class="yellow">
            We make this up how we like
          </p>
        </div>
        <div>
          <%= f.label :active %>
          <%= f.check_box :active %>
          <p class="red">
            Uncheck means Variant not seen (Instead of deleting variant).
          </p>
        </div>
      </div>
    </div>

    <div class="mt-5 mb-5">
      <%= file_field_tag "files[]", id: "files", multiple: true %>
      <%= label_tag "files", "Upload New Images" %>
      <p>To delete images, check the box next to the image then update craft.</p>
    </div>

    <% if @variant.new_record? %>
      <div class="mt-4 mb-4">
        <%= f.submit "Add New Variant", class: "btn btn-primary fs-3" %>
      </div>
    <% else %>
      <div>
        <%= f.submit "Update Variant", class: "btn btn-primary fs-3" %>
      </div>
    <% end %>
    
  <% end %>
</div>


