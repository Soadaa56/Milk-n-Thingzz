<h1>Add New Variant</h1>
<h2 class="mt-3 mb-3"><%= @craft.name %> [<%= @craft.category %>]</h2>

<div class='center d-grid gap-3'>
  <div>
    <%= link_to 'List all crafts', crafts_path, class: 'btn btn-dark fs-5' %>
  </div>
  <div>
    <%= link_to 'Back to Variants', craft_variants_path(@craft), class: 'btn btn-primary fs-4' %>
  </div>
</div>

<%= render 'form' %>

<%= render 'shared/back' %>