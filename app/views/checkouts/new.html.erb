<%# Disabled until stripe account setup %>
<main class="cart">
  <h2>Your Cart</h2>
  
  <div class="cart-container">
    <div>
      <% @cart_items.each do |cart_item| %>
        <%= turbo_frame_tag dom_id(cart_item) do %>
          <%= render "cart_item", cart_item: cart_item %>
        <% end %>
      <% end %>
    </div>

    <div class="cart-checkout">
      <div id="cart-subtotal" class="cart-subtotal">
        <%= render "subtotal", cart: @cart %>
      </div>
      <%= button_to "Checkout securely with Stripe",
        checkout_path,
        method: :post,
        disabled: true,
        class: "disable-checkout",
        data: { turbo: false }
      %>
    </div>
  </div>
</main>