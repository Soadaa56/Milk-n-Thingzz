{
  "name": "app",
  "private": "true",
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "@popperjs/core": "^2.11.8",
    "@rails/actiontext": "^8.1.301",
    "@rails/request.js": "^0.0.11",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "jquery": "^3.7.1",
    "nodemon": "^3.1.14",
    "sortablejs": "^1.15.7",
    "trix": "^2.1.19"
  },
  "scripts": {
    "build": "esbuild app/javascript/*.* --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets",
    "build:css": "sass --load-path=node_modules ./app/assets/stylesheets:./app/assets/builds",
    "watch:css": "nodemon --watch ./app/assets/stylesheets/ --ext scss --exec \"pnpm build:css\""
  },
  "browserslist": [
    "defaults"
  ],
  "devDependencies": {
    "sass": "^1.106.1"
  }
}
